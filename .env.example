# NWS supports locations in the United States and its territories.
NWS_LATITUDE=38.8977
NWS_LONGITUDE=-77.0365
NWS_USER_AGENT="nws-slack-forecast/0.1 (your-email@example.com)"

NWS_ZONE_ID=DCZ001
# Optional display label. Defaults to the city/state returned by NWS.
LOCATION_NAME="Washington, DC"
# Optional IANA timezone. Defaults to the timezone returned by NWS.
# FORECAST_TIMEZONE=America/New_York
# us = Fahrenheit / mph; si = Celsius / km/h (as supplied by NWS).
NWS_UNITS=us
HTTP_TIMEOUT_SECONDS=20
NWS_MAX_ATTEMPTS=3

# Create this incoming webhook for the channel below in your Slack app settings.
# Modern Slack webhooks cannot override their authorized channel.
SLACK_CHANNEL="#weather"
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/REPLACE/WITH/YOUR_WEBHOOK

# Optional: select a channel's webhook using SLACK_CHANNEL. When populated,
# this mapping takes precedence and the selected channel MUST be present.
# Quote the JSON so dotenv preserves channel names and URL contents.
# SLACK_WEBHOOKS='{"#weather":"https://hooks.slack.com/services/TEAM/APP/SECRET","#operations":"https://hooks.slack.com/services/TEAM/APP/OTHER_SECRET"}'
